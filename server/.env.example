# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/smartserve

# Redis
REDIS_URL=redis://127.0.0.1:6379

# Auth
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change_this_too
JWT_REFRESH_EXPIRES_IN=30d

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# Neo4j (graph recommendations) — optional. Leave NEO4J_URI empty to disable.
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# MonetDB (analytics) — optional. Leave MONETDB_DATABASE empty to disable.
MONETDB_HOST=127.0.0.1
MONETDB_PORT=50000
MONETDB_DATABASE=smartserve
MONETDB_USER=monetdb
MONETDB_PASSWORD=monetdb
